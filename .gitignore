# =====================================================================
# Cortex-M Git Ignore Configuration
# Governed by Master Research & Engineering Policy
# =====================================================================

# Virtual Environments
.venv/
.venv*/
env/
venv/
ENV/
*.virtualenv/

# Python Bytecode, Caching & Native Builds
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll
*.dylib

# Packaging & Build Artifacts
build/
dist/
dist_mobile/
*.egg-info/
.eggs/
node_modules/
*.whl

# Testing, Quality & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Operating System & IDEs
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.bak

# Temporary Runtime, Agent Scratch & Logs
*.log
*.tmp
*.temp
.tempmediaStorage/
scratch/
.agents/
.env*
*.key
*.secret
secrets/

# SQLite Caches & Ephemeral Data Stores
data/visualizer_memory.sqlite3*
data/*.sqlite3*
data/cache/
*.db
*.sqlite

# Large Model Checkpoints & Raw Weights (Avoid committing GB-scale binary blobs)
models/*.gguf
models/*.bin
models/*.pt
!models/checkpoints/
!models/checkpoints/*_baseline.pt
models/*.pth
models/*.safetensors
models/cache/
/checkpoints/

# Internal Research, Tests, Intermediate Results & Benchmarks (Excluded from Production Distribution)
tests/
tests_e2e/
tests_mimo/
benchmarks/
results/
reports/
plans/
CORTEX_Ecosystem_PRD_SRS_Pack/
CORTEX_M_Master_Research_Pack/
00_README_and_Approval_Guide.docx
