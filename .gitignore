# =====================================================================
# Cortex-M Git Ignore Configuration
# Governed by Master Research & Engineering Policy
# =====================================================================

# Virtual Environments
.venv/
.venv*/
env/
venv/
ENV/
*.virtualenv/

# Python Bytecode, Caching & Native Builds
__pycache__/
*.py[cod]
*$py.class
*.so
*.pyd
*.dll
*.dylib

# Packaging & Build Artifacts
build/
dist/
dist_mobile/
*.egg-info/
.eggs/
node_modules/
*.whl

# Testing, Quality & Coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.mypy_cache/
.ruff_cache/
.hypothesis/

# Operating System & IDEs
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini
*.bak

# Temporary Runtime, Agent Scratch & Logs
*.log
*.tmp
*.temp
.tempmediaStorage/
scratch/
.agents/
.env*
*.key
*.secret
secrets/

# SQLite Caches & Ephemeral Data Stores
data/visualizer_memory.sqlite3*
data/*.sqlite3*
data/cache/
*.db
*.sqlite

# Large Model Checkpoints & Raw Weights (Avoid committing GB-scale binary blobs)
models/*.gguf
models/*.bin
models/*.pt
models/*.pth
models/*.safetensors
models/cache/
checkpoints/

# Ephemeral Test/Experiment Run Outputs (keep summary json/reports, exclude raw batch run dumps)
results/core-*
results/rule-*
results/acceptance-*
results/mimo93-*
results/scale-probe-*
results/system-audit-*
results/mimo-sparse-router-*
results/phase-check-*
results/*/*.jsonl
results/*/*.pt
